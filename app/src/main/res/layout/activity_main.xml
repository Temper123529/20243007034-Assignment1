<?xml version="1.0" encoding="utf-8"?>
<!-- Root layout: vertical full-screen container with responsive weight distribution -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Welcome banner: occupies 50% of screen height via layout_weight -->
    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Welcome to\nCampusLife - Your Pocket Guide to\nUniversity of Waikato"
        android:textSize="40sp"
        android:textAlignment="center"/>

    <!-- Button container: occupies remaining 50% of screen height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- First row: Facilities and Events buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gap="16dp">

            <!-- Navigation button for Facilities section -->
            <ImageButton
                android:id="@+id/btn_facilities"
                android:layout_width="0dp"
                android:background="@drawable/btn_selector"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img_btn_facilities"
                android:scaleType="centerInside"
                android:contentDescription="Facilities"/>

            <!-- Navigation button for Events section -->
            <ImageButton
                android:id="@+id/btn_events"
                android:layout_width="0dp"
                android:background="@drawable/btn_selector"

                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img_btn_events"
                android:scaleType="centerInside"
                android:contentDescription="Events"/>
        </LinearLayout>

        <!-- Second row: Clubs and Support buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gap="16dp"
            android:layout_marginTop="16dp">

            <!-- Navigation button for Clubs section -->
            <ImageButton
                android:id="@+id/btn_clubs"
                android:layout_width="0dp"
                android:background="@drawable/btn_selector"

                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img_btn_clubs"
                android:scaleType="centerInside"
                android:contentDescription="Clubs"/>

            <!-- Navigation button for Support section -->
            <ImageButton
                android:id="@+id/btn_support"
                android:layout_width="0dp"
                android:background="@drawable/btn_selector"

                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img_btn_support"
                android:scaleType="centerInside"
                android:contentDescription="Support"/>


        </LinearLayout>
    </LinearLayout>

</LinearLayout>
